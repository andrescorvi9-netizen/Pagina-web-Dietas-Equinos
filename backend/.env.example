# Plantilla de variables de entorno. Copiar a backend/.env y completar.
# NUNCA subir backend/.env a git.

# --- Opción A: PostgreSQL local (sin SSL) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=dietas_equinos
PGUSER=postgres
PGPASSWORD=tu_contraseña

# --- Opción B: Neon (SSL se activa automáticamente si el host no es local) ---
# Copiar los valores desde el panel de Neon (botón "Connect").
# PGHOST=ep-xxxx-pooler.region.aws.neon.tech
# PGHOST_UNPOOLED=ep-xxxx.region.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=tu_contraseña

PORT=3000
