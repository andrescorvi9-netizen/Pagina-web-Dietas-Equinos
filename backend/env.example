# Copia este archivo como ".env" dentro de backend/ y completa los valores reales.
# ".env" nunca debe subirse al repositorio (ver .gitignore).

PORT=3000

# --- Conexión a PostgreSQL (fase actual: local) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=dietas_equinos
PGUSER=postgres
PGPASSWORD=123456

# --- Cuando migres a Neon (vía Vercel) ---
# Neon entrega cadenas de conexión completas, no variables sueltas.
# Si mantienes el Pool de pg basado en variables PG*, tendrás que parsear
# el host/usuario/password/db desde la cadena que te da Neon, o cambiar
# db.js para aceptar connectionString en vez de campos sueltos.
# Ejemplo de las dos cadenas que entrega Neon (pooled y directa):
# DATABASE_URL=postgres://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/dietas_equinos?sslmode=require
# DIRECT_URL=postgres://usuario:password@ep-xxxx.region.aws.neon.tech/dietas_equinos?sslmode=require
# PGSSLMODE=require
